{
  "name": "@local/dsh-archive-cleanup",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Permanently delete archived sessions to free disk space",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  },
  "scripts": { "test": "node --test tests/*.test.mjs" }
}
