{
  "name": "@local/dsh-kiss-preset",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "description": "KISS模式：少约束、少干预，极简提速，让模型自主思考、直接解决问题。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wooly99/dsh-plugins.git",
    "directory": "kiss-preset"
  },
  "exports": {
    "./context": "./context.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "context.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "verify.cjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
