{
  "name": "@local/dsh-ui-enhancements",
  "version": "1.4.0",
  "private": true,
  "description": "Three independently switchable UI enhancements for DeepSeek Harness",
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "dependencies": {
    "@local/dsh-ui-enhancements-workspace-header": "git+https://github.com/wooly99/dsh-plugins.git#5bf99f39cd560b2d3e7dfe4d4832d357dad67f77&path:/ui-enhancements/components/workspace-header",
    "@local/dsh-ui-enhancements-workspace-status": "git+https://github.com/wooly99/dsh-plugins.git#5bf99f39cd560b2d3e7dfe4d4832d357dad67f77&path:/ui-enhancements/components/workspace-status",
    "@local/dsh-ui-enhancements-turn-diff": "git+https://github.com/wooly99/dsh-plugins.git#5bf99f39cd560b2d3e7dfe4d4832d357dad67f77&path:/ui-enhancements/components/turn-diff"
  },
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["cordis.patch.yml", "README.md", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
