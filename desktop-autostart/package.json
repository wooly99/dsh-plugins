{
  "name": "@local/dsh-desktop-autostart",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Launch the DSH desktop app at Windows sign-in from General settings",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "windows.ps1", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "engines": { "dsh": ">=0.2.2-rc.5 <0.3.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml", "platforms": ["win32"] },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
